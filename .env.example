# --- Telegram ---
BOT_TOKEN=123456:ABC...            # @BotFather dan
BOT_USERNAME=my_operator_bot       # @ belgisisiz
PUBLIC_BASE_URL=https://ai.example.uz   # HTTPS domen: webhook shu yerga o'rnatiladi
PUBLIC_WEB_URL=                    # sayt boshqa domenda bo'lsa (bo'sh = PUBLIC_BASE_URL)
WEBHOOK_SECRET=uzun-tasodifiy-satr
BOT_MODE=webhook                   # domen/HTTPS yo'q bo'lsa: polling (+ docker compose --profile polling)

# --- Instagram (ixtiyoriy; Meta ilovasi: Instagram API with Instagram Login) ---
IG_APP_ID=                         # Instagram App ID (Meta ilova → Instagram → API setup)
IG_APP_SECRET=                     # Instagram App Secret (webhook imzosi ham shu bilan tekshiriladi)
IG_VERIFY_TOKEN=uzun-tasodifiy-satr   # webhook sozlashda Meta'ga ham shu qiymat kiritiladi

# --- LLM (Claude) ---
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-haiku-4-5         # arzon/tez asosiy model
LLM_FALLBACK_MODEL=claude-sonnet-5 # asosiy ishlamasa
LLM_PRICE_IN=1.0                   # USD / 1M token (xarajat hisobi uchun, modelga moslang)
LLM_PRICE_OUT=5.0
USD_TO_UZS=12700

# --- Ixtiyoriy ---
VOYAGE_API_KEY=                    # semantik qidiruv (bo'sh bo'lsa faqat trigram)
STT_API_URL=                       # ovozli xabarlar: OpenAI-mos /v1/audio/transcriptions URL
STT_API_KEY=
STT_MODEL=whisper-1

# --- Xavfsizlik / infra ---
SECRET_KEY=uzun-tasodifiy-satr     # sessiya (JWT) imzosi — albatta o'zgartiring
COOKIE_SECURE=true                 # HTTPS bo'lmagan lokal sinovda false
POSTGRES_PASSWORD=aiop
WEB_PORT=80                        # sayt porti (80 band bo'lsa, masalan 8090)
