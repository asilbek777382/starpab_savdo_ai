# Navbatchi AI — serverga joylash uchun kalitlar.
# Nusxa oling: cp deploy/secrets.env.example deploy/secrets.env  — va qiymatlarni to'ldiring.
# deploy/secrets.env git'ga tushmaydi (.gitignore). Skript uni faqat o'qiydi va qiymatlarni
# serverdagi /home/online_savdo/.env ga yozadi (chmod 600).

# --- Majburiy ---
ANTHROPIC_API_KEY=            # console.anthropic.com → API Keys
BOT_TOKEN=                    # @BotFather → /newbot (keyin Bot Settings → Business Mode → ON)
BOT_USERNAME=                 # @ belgisisiz, masalan: navbatchi_ai_bot

# Platforma admini (birinchi o'rnatishda). Akkaunt allaqachon bo'lsa paroli o'zgarmaydi.
ADMIN_PHONE=                  # +998901234567
ADMIN_PASSWORD=               # kamida 8 belgi

# --- Ixtiyoriy ---
# Instagram Direct (HTTPS domen kerak): developers.facebook.com → ilova → Instagram API with Instagram Login
IG_APP_ID=
IG_APP_SECRET=

# Ovozli javoblar: Azure portal → Speech resursi → Keys and Endpoint
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=          # masalan: westeurope

# Obuna to'lovi (HTTPS domen kerak)
PAYME_MERCHANT_ID=
PAYME_KEY=
# PAYME_CHECKOUT_URL=https://test.paycom.uz   # sinov rejimi
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# Domen bo'lsa (masalan https://navbatchi.uz). Bo'sh — http://<server-ip>:<port>
PUBLIC_URL=
